        "findings": [
          {
            "description": "MATURA_KEK is set; secrets are sealed with AES-256-GCM envelope encryption. Fix: Set MATURA_KEK to 32 random bytes, base64 (openssl rand -base64 32), and back it up apart from the database.",
            "related-observations": [
              {
                "observation-uuid": "3b632cbd-a04c-51e9-9deb-aef5274a3aa8"
              }
            ],
            "target": {
              "status": {
                "state": "satisfied"
              },
              "target-id": "install-kek",
              "type": "objective-id"
            },
            "title": "Stored secrets are encrypted under an operator-held key",
            "uuid": "d1d42efb-d315-52c6-bf1f-322535ada442"
          },
          {
            "description": "tenant keys are on: deleting a tenant destroys its keys, so its sealed data cannot be read again, from backups either (crypto-shredding). Fix: Leave MATURA_TENANT_KEYS on (the default): tenant secrets and app data keys are sealed under per-tenant keys, which are erased when a tenant is deleted.",
            "related-observations": [
              {
                "observation-uuid": "e5457d9b-2416-57fb-8513-22af7af3f2d0"
              }
            ],
            "target": {
              "status": {
                "state": "satisfied"
              },
              "target-id": "install-tenant-keys",
              "type": "objective-id"
            },
            "title": "Each tenant's secrets are sealed under its own key, destroyed when it is deleted",
            "uuid": "0edff757-6e96-5449-9abc-306ddb20fe63"
          },
          {
